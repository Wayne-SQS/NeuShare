# ===== DeepSeek LLM (required) =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding =====
# default: local Chinese model via sentence-transformers (no key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# HuggingFace mirror for model download in China (optional)
HF_ENDPOINT=https://hf-mirror.com
# alternative: set EMBEDDING_PROVIDER=zhipu and fill ZHIPU_API_KEY
# ZHIPU_API_KEY=
# ZHIPU_EMBEDDING_MODEL=embedding-3

# ===== JWT（必填，必须与主后端 JWT_SECRET 完全一致；无任何默认值）=====
JWT_SECRET=change-me-to-the-same-secret-as-main-backend-at-least-32-bytes

# ===== MySQL (demo instance) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your-db-password
MYSQL_DB=neushare

# ===== 主后端地址（Python FastAPI，端口仍是 8080；compose 中指向 http://backend:8080）=====
# 变量名沿用 JAVA_BACKEND_URL 以兼容既有部署配置
JAVA_BACKEND_URL=http://localhost:8080

# ===== Service =====
AI_SERVICE_PORT=8000
VECTORSTORE_DIR=./vectorstore
UPLOADS_DIR=../uploads
RATE_LIMIT_PER_MINUTE=10

