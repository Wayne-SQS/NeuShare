# 复制本文件为 .env 再填值。.env 已被 .gitignore 忽略，绝对不要提交到公开仓库。
# 这个文件只放"键名"，不放任何真实密钥。

# DeepSeek 聊天模型（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 兼容别名，实测服务端重定向到 deepseek-flash（非思考模式，上下文 1M / 最大输出 384K）。
# 官方原定 2026-07-24 弃用此别名；将来若失效，显式改 deepseek-flash 时必须同时关闭思考模式。
# 思考模式 + 强制 tool_choice 会 400；本服务用 LangChain 普通 tool calling，不强制，故可用。
DEEPSEEK_MODEL=deepseek-chat

# Tavily 联网搜索（https://tavily.com 注册后在 API Keys 页面拿 tvly- 开头的 key）
TAVILY_API_KEY=
# 海外接口若需要代理，填 http://127.0.0.1:7897；留空则跟随系统代理设置
TAVILY_PROXY=

# Java 业务后端地址（站内资源检索走它，只读，不写库）
NEUSHARE_API_BASE=http://127.0.0.1:8080

# 服务配置
AI_SERVICE_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=20
TAVILY_MAX_RESULTS=5

# 无 key 演示：true 时用固定的占位结果跑通全链路，不发外网、不编造真实链接
MOCK_MODE=false

# 上下文窗口保护（历史超阈值时归纳总结成摘要；被压缩内容先归纳、不直接删）
MEMORY_ENABLED=true
MEMORY_MAX_MESSAGES=40
MEMORY_MAX_TOKENS=12000
MEMORY_KEEP_RECENT=8
# 直接删旧工具输出原文（不可逆、无归纳）——默认关闭，信息保真优先；确要省 token 再开
MEMORY_CLEAR_TOOL_ENABLED=false
MEMORY_CLEAR_TOOL_TOKENS=8000
MEMORY_CLEAR_TOOL_KEEP=3
