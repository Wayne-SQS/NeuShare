# ===== JWT (MUST be identical to neushare-ai's JWT_SECRET for token interop) =====
# Must be >= 32 bytes. jjwt auto-selects HS256/384/512 by key length.
JWT_SECRET=change-me-to-the-same-secret-as-java-backend-at-least-32-bytes
JWT_EXPIRATION=86400000

# ===== MySQL (asyncmy) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your-db-password
MYSQL_DB=neushare

# ===== Redis (cache + counters). Optional: leave empty to run cache-degraded. =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Uploads =====
UPLOAD_PATH=../neushare-backend/uploads

# ===== CORS (comma-separated origins) =====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Service =====
PORT=8080

# ===== V7 BYOK: 用户自带 AI Key 的加密主密钥（与 neushare-ai 无关，仅主后端使用） =====
AI_KEY_ENCRYPT_SECRET=change-me-to-a-long-random-secret

# ===== V5 结构化检索 =====
SEARCH_FULLTEXT_ENABLED=true
