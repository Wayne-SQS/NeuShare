<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neushare.mapper.PostCommentLikeMapper">

    <select id="selectByUserIdAndCommentId" resultType="com.neushare.entity.PostCommentLike">
        SELECT * FROM post_comment_like WHERE user_id = #{userId} AND comment_id = #{commentId}
    </select>

</mapper>
