<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neushare.mapper.ResourceLikeMapper">

    <select id="selectByUserIdAndResourceId" resultType="com.neushare.entity.ResourceLike">
        SELECT * FROM resource_like WHERE user_id = #{userId} AND resource_id = #{resourceId}
    </select>

</mapper>
