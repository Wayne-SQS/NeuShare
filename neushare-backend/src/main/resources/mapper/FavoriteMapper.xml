<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neushare.mapper.FavoriteMapper">

    <resultMap id="ResourceVOMap" type="com.neushare.vo.ResourceVO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="category_id" property="categoryId"/>
        <result column="category_name" property="categoryName"/>
        <result column="type" property="type"/>
        <result column="content_url" property="contentUrl"/>
        <result column="description" property="description"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="upload_user_id" property="uploadUserId"/>
        <result column="status" property="status"/>
        <result column="view_count" property="viewCount"/>
        <result column="like_count" property="likeCount"/>
        <result column="favorite_count" property="favoriteCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="upload_username" property="uploadUsername"/>
        <result column="upload_nickname" property="uploadNickname"/>
        <result column="upload_avatar" property="uploadAvatar"/>
    </resultMap>

    <select id="selectUserFavorites" resultMap="ResourceVOMap">
        SELECT r.id, r.title, r.category_id, r.type, r.content_url, r.description, r.cover_url,
               r.upload_user_id, r.status, r.view_count, r.like_count, r.favorite_count,
               r.create_time, r.update_time,
               u.username as upload_username, u.nickname as upload_nickname, u.avatar_url as upload_avatar,
               c.name as category_name
        FROM favorite f
        LEFT JOIN resource r ON f.resource_id = r.id
        LEFT JOIN user u ON r.upload_user_id = u.id
        LEFT JOIN category c ON r.category_id = c.id
        WHERE f.user_id = #{userId}
        AND r.id IS NOT NULL
        ORDER BY f.create_time DESC
    </select>

    <select id="selectByUserIdAndResourceId" resultType="com.neushare.entity.Favorite">
        SELECT * FROM favorite WHERE user_id = #{userId} AND resource_id = #{resourceId}
    </select>

</mapper>
